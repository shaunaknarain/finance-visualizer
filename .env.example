# Copy this file to ".env" and fill it in:
#   cp .env.example .env

# --- Login gate (required) ---
# The single password you'll type to get into the dashboard.
FINANCE_PASSWORD=change-me-to-something-good
# Random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Plaid (optional) ---
# Leave these BLANK to run in demo mode (fake data, no signup needed).
# Get them free at https://dashboard.plaid.com -> Team Settings -> Keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = fake banks (test login user_good / pass_good)
# production = your real banks (needs Plaid production access)
PLAID_ENV=sandbox

# Port for the finance app.
FINANCE_PORT=4000
